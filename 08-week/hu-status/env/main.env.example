# Copy to env/main.env — the real file carries secrets and is never versioned
# (rules/3-Anexo-J, J.5.1). Used as: docker compose --env-file env/main.env ...

COMPOSE_PROJECT_NAME=lms-postgres-main

PG_DATABASE=lms_db
PG_ADMIN_USER=lms_admin
PG_ADMIN_PASSWORD=change-me-admin-password

MEMBERSHIP_APP_PASSWORD=change-me-membership-password
CATALOG_APP_PASSWORD=change-me-catalog-password
